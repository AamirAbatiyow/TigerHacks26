{
  "name": "scriptwell",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5173 --strictPort",
    "dev:analytics": "node server/receiver.mjs",
    "dev:all": "node server/dev.mjs",
    "test": "node --import tsx --test tests/*.test.mjs tests/*.test.ts",
    "format": "prettier --write src server tests vite.config.ts package.json tsconfig.json",
    "format:check": "prettier --check src server tests vite.config.ts package.json tsconfig.json"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~5.7.2",
    "vite": "^6.4.0"
  },
  "engines": {
    "node": ">=20.12.0"
  }
}
