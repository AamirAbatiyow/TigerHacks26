# Restart dev servers after changes. Rebuild the frontend for deployment.
# HTTP is intentional for the fictional-data tshark demonstration.
VITE_ANALYTICS_URL=http://fly-analytics.fly.dev/collect
# Offline fallback: VITE_ANALYTICS_URL=http://localhost:4318/v1/events
# The settings below apply only to the optional local receiver.
ANALYTICS_PORT=4318
ANALYTICS_HOST=localhost
ALLOWED_ORIGIN=http://localhost:5173
APP_PORT=5173
