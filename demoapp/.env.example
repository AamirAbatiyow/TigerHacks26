# Restart dev servers after changes. Rebuild the frontend for deployment.
# HTTPS is the default. Override with HTTP only for the synthetic tshark demonstration.
# Production (Fly) sets the same variable as a build arg in fly.toml.
VITE_ANALYTICS_URL=https://fly-analytics.fly.dev/collect
# Offline fallback: VITE_ANALYTICS_URL=http://localhost:4318/v1/events
# The settings below apply only to the optional local receiver.
ANALYTICS_PORT=4318
ANALYTICS_HOST=localhost
ALLOWED_ORIGIN=http://localhost:5173
APP_PORT=5173
