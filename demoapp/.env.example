# Restart dev servers after changes. Rebuild the frontend for deployment.
# Browser traffic goes to the local bridge; the bridge forwards over HTTP to Fly.
VITE_ANALYTICS_URL=http://localhost:4319/collect
# Optional offline receiver: VITE_ANALYTICS_URL=http://localhost:4318/v1/events
# The settings below apply only to the optional local receiver.
ANALYTICS_PORT=4318
ANALYTICS_HOST=localhost
ALLOWED_ORIGIN=http://localhost:5173
APP_PORT=5173
