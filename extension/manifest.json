{
  "manifest_version": 3,
  "name": "PatientPrivy",
  "version": "1.0.0",
  "description": "See where your health-related data is going.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "webRequest"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "https://fly-analytics.fly.dev/*",
    "http://fly-analytics.fly.dev/*",
    "http://localhost:5173/*",
    "http://127.0.0.1:5173/*",
    "https://scriptwell.fly.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
